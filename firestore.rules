rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can access only their own user document.
    // Admins can access all user documents.
    match /users/{userId} {
      allow read: if request.auth != null
                    && (
                      request.auth.uid == userId
                      || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                    );

      // A normal user may create their own profile,
      // but can only choose artisan or buyer.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role in ['artisan', 'buyer'];

      // Normal users cannot change their role.
      // Admins can update user documents.
      allow update: if request.auth != null
                    && (
                      (
                        request.auth.uid == userId
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.role in ['artisan', 'buyer']
                      )
                      || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                    );

      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Keep other collections unchanged for now.
    // We will secure them as their services are migrated.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 10, 3);
    }
  }
}